{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "input_sha256",
    "controller_reviewed",
    "preview_review_evidence",
    "slides"
  ],
  "properties": {
    "input_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "controller_reviewed": {
      "const": true
    },
    "preview_review_evidence": {
      "type": "string",
      "minLength": 1
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "page",
          "teaching_reason",
          "initial_state",
          "final_state",
          "effects",
          "manual_issues",
          "content_roles_reviewed",
          "visibility_rules"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "replace_targets": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "shape",
                "shape_id",
                "role",
                "reason",
                "trigger",
                "click_group",
                "separable"
              ],
              "properties": {
                "shape": {
                  "type": "integer",
                  "minimum": 1
                },
                "shape_id": {
                  "type": "integer",
                  "minimum": 1
                },
                "trigger": {
                  "enum": [
                    "click",
                    "with_previous"
                  ]
                },
                "separable": {
                  "const": true
                },
                "duration": {
                  "type": "number",
                  "minimum": 0.2,
                  "maximum": 1.2
                }
              }
            }
          },
          "manual_issues": {
            "type": "array"
          },
          "content_roles_reviewed": {
            "const": true
          },
          "visibility_rules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "shape_id",
                "role",
                "reveal_click",
                "reason"
              ],
              "properties": {
                "shape_id": {
                  "type": "integer",
                  "minimum": 1
                },
                "role": {
                  "enum": [
                    "prompt",
                    "answer",
                    "explanation",
                    "illustration"
                  ]
                },
                "reveal_click": {
                  "type": "integer",
                  "minimum": 0
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    },
    "font_repairs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "page",
          "shape_id",
          "unit_kind",
          "start",
          "end",
          "text",
          "whole_unit_confirmed",
          "bold",
          "reason",
          "bold_reason",
          "boundary_reason",
          "single_font_intent_evidence",
          "visual_evidence"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "shape_id": {
            "type": "integer",
            "minimum": 1
          },
          "unit_kind": {
            "enum": [
              "sentence",
              "title"
            ]
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "whole_unit_confirmed": {
            "const": true
          },
          "bold": {
            "type": "boolean"
          },
          "mode": {
            "enum": [
              "compatibility",
              "reference_match"
            ]
          },
          "target_font": {
            "type": "string",
            "minLength": 1
          },
          "candidate_fonts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "non_premium": {
            "const": true
          },
          "font_file": {
            "type": "string",
            "minLength": 1
          },
          "font_face_index": {
            "type": "integer",
            "minimum": 0
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "mode"
              ]
            },
            "then": {
              "required": [
                "target_font",
                "candidate_fonts",
                "non_premium",
                "font_file",
                "font_match_reason",
                "sample_review_evidence"
              ]
            }
          },
          {
            "if": {
              "required": [
                "mode"
              ],
              "properties": {
                "mode": {
                  "const": "reference_match"
                }
              }
            },
            "then": {
              "required": [
                "reference_visual"
              ]
            }
          }
        ]
      }
    },
    "font_handoff_resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "handoff_id",
          "status",
          "reason"
        ],
        "properties": {
          "handoff_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "replace",
              "no_change",
              "blocked"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "shape_id": {
            "type": "integer",
            "minimum": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "replace",
                    "no_change"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "page",
                "shape_id",
                "mapping_reason",
                "visual_evidence"
              ]
            }
          }
        ]
      }
    }
  },
  "additionalProperties": true
}
