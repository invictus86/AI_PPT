{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "input_sha256",
    "controller_reviewed",
    "preview_review_evidence",
    "slides"
  ],
  "properties": {
    "input_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "controller_reviewed": {
      "const": true
    },
    "preview_review_evidence": {
      "type": "string",
      "minLength": 1
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "page",
          "teaching_reason",
          "initial_state",
          "final_state",
          "effects",
          "manual_issues",
          "content_roles_reviewed",
          "visibility_rules"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "replace_targets": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "shape",
                "shape_id",
                "role",
                "reason",
                "trigger",
                "click_group",
                "separable"
              ],
              "properties": {
                "shape": {
                  "type": "integer",
                  "minimum": 1
                },
                "shape_id": {
                  "type": "integer",
                  "minimum": 1
                },
                "trigger": {
                  "enum": [
                    "click",
                    "with_previous"
                  ]
                },
                "separable": {
                  "const": true
                },
                "duration": {
                  "type": "number",
                  "minimum": 0.2,
                  "maximum": 1.2
                }
              }
            }
          },
          "manual_issues": {
            "type": "array"
          },
          "content_roles_reviewed": {
            "const": true
          },
          "visibility_rules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "shape_id",
                "role",
                "reveal_click",
                "reason"
              ],
              "properties": {
                "shape_id": {
                  "type": "integer",
                  "minimum": 1
                },
                "role": {
                  "enum": [
                    "prompt",
                    "answer",
                    "explanation",
                    "illustration"
                  ]
                },
                "reveal_click": {
                  "type": "integer",
                  "minimum": 0
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
