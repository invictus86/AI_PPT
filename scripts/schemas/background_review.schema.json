{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PPT Skill background click state acceptance",
  "type": "object",
  "required": ["method", "controller_reviewed", "input_sha256", "output_sha256", "plan_sha256", "manifest_sha256", "unresolved_issues", "states"],
  "properties": {
    "method": {"const": "background_click_states"},
    "controller_reviewed": {"const": true},
    "input_sha256": {"$ref": "#/$defs/hash"},
    "output_sha256": {"$ref": "#/$defs/hash"},
    "plan_sha256": {"$ref": "#/$defs/hash"},
    "manifest_sha256": {"$ref": "#/$defs/hash"},
    "unresolved_issues": {"type": "array", "maxItems": 0},
    "states": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["page", "step", "pass", "image_sha256", "visibility_observation", "answer_leakage_observation", "background_residue_observation", "font_observation", "layout_observation"],
        "properties": {
          "page": {"type": "integer", "minimum": 1},
          "step": {"type": "integer", "minimum": 0},
          "pass": {"const": true},
          "image_sha256": {"$ref": "#/$defs/hash"},
          "visibility_observation": {"$ref": "#/$defs/observation"},
          "answer_leakage_observation": {"$ref": "#/$defs/observation"},
          "background_residue_observation": {"$ref": "#/$defs/observation"},
          "font_observation": {"$ref": "#/$defs/observation"},
          "layout_observation": {"$ref": "#/$defs/observation"}
        }
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "observation": {"type": "string", "minLength": 1, "pattern": "\\S"}
  }
}
