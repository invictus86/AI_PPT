{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PPT Skill v3 Stage2 Aesthetic Review",
  "type": "object",
  "required": ["schema_version", "overall_status", "review_scope", "checks", "slide_findings", "rework_recommendation", "text_review_basis", "text_reviews"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "overall_status": { "type": "string", "enum": ["pass", "needs_rework"] },
    "review_scope": { "type": "string", "enum": ["cover_options", "trial_first5", "full_image_deck"] },
    "checks": {
      "type": "object",
      "required": [
        "visual_system_consistency",
        "text_readability",
        "content_text_accuracy",
        "page_role_fit",
        "image_relevance",
        "no_fake_text_or_placeholders",
        "density_and_hierarchy",
        "page_number_policy",
        "header_position_consistency",
        "section_intro_consistency"
      ],
      "properties": {
        "visual_system_consistency": { "type": "string", "enum": ["pass", "needs_rework"] },
        "text_readability": { "type": "string", "enum": ["pass", "needs_rework"] },
        "content_text_accuracy": { "type": "string", "enum": ["pass", "needs_rework"] },
        "page_role_fit": { "type": "string", "enum": ["pass", "needs_rework"] },
        "image_relevance": { "type": "string", "enum": ["pass", "needs_rework"] },
        "no_fake_text_or_placeholders": { "type": "string", "enum": ["pass", "needs_rework"] },
        "density_and_hierarchy": { "type": "string", "enum": ["pass", "needs_rework"] },
        "page_number_policy": { "type": "string", "enum": ["pass", "needs_rework"] },
        "header_position_consistency": { "type": "string", "enum": ["pass", "needs_rework"] },
        "section_intro_consistency": { "type": "string", "enum": ["pass", "needs_rework"] }
      },
      "additionalProperties": true
    },
    "text_review_basis": {
      "type": "object", "minProperties": 2,
      "required": ["_state/阶段1/content.json", "阶段1_规划确认/每页干净逐字稿.md"],
      "additionalProperties": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
    },
    "text_reviews": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slide_index", "image_path", "image_sha256", "reference_text", "controller_reviewed", "status", "evidence"],
        "properties": {
          "slide_index": { "type": "integer", "minimum": 1 },
          "option_id": { "enum": ["A", "B", "C", "D"] },
          "image_path": { "type": "string", "minLength": 1 },
          "image_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "reference_text": { "type": "array", "items": { "type": "string" } },
          "controller_reviewed": { "type": "boolean" },
          "status": { "enum": ["pass", "needs_rework"] },
          "evidence": { "type": "string" }
        },
        "allOf": [{
          "if": { "properties": { "status": { "const": "pass" } } },
          "then": { "properties": { "controller_reviewed": { "const": true }, "evidence": { "pattern": "\\S" } } }
        }]
      }
    },
    "slide_findings": { "type": "array", "items": { "type": "object" } },
    "rework_recommendation": {
      "type": "object",
      "required": ["target", "reason"],
      "properties": {
        "target": { "type": "string", "enum": ["stage2_design_plan", "stage2_cover", "stage2_prompt", "selected_slides", "none"] },
        "reason": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "allOf": [{
    "if": { "properties": { "overall_status": { "const": "pass" } } },
    "then": { "properties": { "text_reviews": { "items": { "properties": { "status": { "const": "pass" } } } } } }
  }],
  "additionalProperties": true
}
